+  if (!draft) return <section aria-label="Model workspace"><p role="status">{pending?'Loading selected model…':'Workspace could not be loaded.'}</p><p role="alert">{error}</p><button onClick={load} disabled={pending}>Retry</button></section>;
+  return <section aria-label="Model workspace" style={{overflowWrap:'anywhere'}}>
