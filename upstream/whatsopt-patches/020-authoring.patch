+            <td><select aria-label={`Port ${i+1} direction`} value={p.io_mode} onChange={e=>componentEdit('ports',selectedComponent.ports.map((v,j)=>j===i?{...v,io_mode:e.target.value}:v))}><option value="in">Input</option><option value="out">Output</option></select></td>
+            <td><input aria-label={`Port ${i+1} units`} placeholder="dimensionless" value={p.units || ''} onChange={e=>componentEdit('ports',selectedComponent.ports.map((v,j)=>j===i?{...v,units:e.target.value}:v))}/></td>
+          </tr>)}</tbody></table></div>
+          <button className="btn btn-secondary" onClick={()=>componentEdit('ports',[...selectedComponent.ports,{name:'',io_mode:'in',units:'',type:'Float',shape:'1'}])}>Add port</button>{' '}
+          <button className="btn btn-secondary" onClick={starter}>Generate Python starter</button>
+        </details>
+        <details open><summary>Code</summary><label className="d-block">Python compute body<textarea className="form-control" rows="10" spellCheck="false" style={{fontFamily:'monospace',whiteSpace:'pre',overflowX:'auto'}} value={selectedComponent.source} onChange={e=>componentEdit('source',e.target.value)}/></label></details>
+        <details><summary>Assumptions</summary><label className="d-block">Assumption notes<textarea className="form-control" rows="3" placeholder="No assumptions recorded. Add a note for this component." value={selectedComponent.notes} onChange={e=>componentEdit('notes',e.target.value)}/></label></details>
+        <button className="btn btn-outline-danger" onClick={()=>{if(window.confirm(`Remove ${selectedComponent.name} and its connections? Affected native port IDs: ${selectedComponent.ports.map(p=>p.id).filter(Boolean).join(', ')}. Earlier records remain unchanged.`)){setDraft({...draft,components:draft.components.filter(c=>c.id!==selected),remove_components:[...(draft.remove_components||[]),selected].filter(id=>id>0)});setSelected(null);}}}>Remove component</button>
+      </div>}
+      <div className="my-3"><button className="btn btn-primary" onClick={save} disabled={!dirty}>Save changes</button>{' '}<button className="btn btn-secondary" onClick={validate} disabled={dirty}>Validate model</button></div>
+      <p>Run is unavailable until a compatible configuration and verified worker are ready.</p><button className="btn btn-primary" disabled>Run model</button>
+    </fieldset>
+    {navigation && <div role="dialog" aria-modal="true" aria-label="Unsaved changes" className="alert alert-warning"><p>Discard unsaved changes? They have not been saved.</p><button autoFocus onClick={()=>setNavigation(null)}>Keep editing</button>{' '}<button onClick={()=>{window.onbeforeunload=null;setDraft(saved);setNavigation(null);setTimeout(()=>{window.location.href=navigation;},0);}}>Discard changes</button>{' '}<button onClick={async()=>{if(await save()){setNavigation(null);setTimeout(()=>{window.location.href=navigation;},0);}}}>Save changes</button></div>}
+  </section>;
+}
