+    const content = JSON.stringify({expected_revision:saved.revision,payload});
+    if(receipt.current?.content !== content) receipt.current={content,id:crypto.randomUUID()};
+    try {
+      const value=await request('/save',{command_id:receipt.current.id,expected_revision:saved.revision,payload});
+      setSaved(value); setDraft(clone(value)); setStatus('Changes saved. No code was executed.');
+      setSelected(value.components.find(c=>c.id===selected)?.id || value.components.at(-1)?.id || null);
+      onSaved(); return true;
+    } catch(e) {setError(e.message); return false;} finally {setPending(false);}
+  }
+  async function validate() {setPending(true); setError(''); try {await request('/validate',{expected_revision:saved.revision});setStatus('Static validation passed. Runtime behavior is checked only inside the worker.');}catch(e){setError(e.message);}finally{setPending(false);}}
+  function addComponent() {
+    const id=-Date.now(); edit('components',[...draft.components,{id,name:newName,source:"raise NotImplementedError('Declare ports, then write this compute body')\n",notes:'',ports:[]}]);setSelected(id);setNewName('');
+  }
+  function example() {
+    const port=(name,io_mode)=>({name,io_mode,units:'',shape:'1',type:'Float'});
+    edit('components', [{id:-1,name:'First',source:"outputs['u'] = 2 * inputs['x'] + inputs['z']\n",notes:'',ports:[port('x','in'),port('z','in'),port('u','out')]},{id:-2,name:'Second',source:"outputs['y'] = inputs['u'] * inputs['u']\n",notes:'',ports:[port('u','in'),port('y','out')]}]);setSelected(-1);
+  }
