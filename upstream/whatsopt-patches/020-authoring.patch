+  const [error, setError] = useState(''), [status, setStatus] = useState('');
+  const [navigation, setNavigation] = useState(null), [newName, setNewName] = useState('');
+  const receipt = useRef(null);
+  const [models, setModels] = useState([]);
+  useEffect(()=>{fetch('/api/v1/hyprn_mvp/models').then(r=>r.json()).then(setModels).catch(()=>setError('Models could not be loaded. Reload the workspace.'));},[]);
+  const dirty = saved && draft && JSON.stringify(saved) !== JSON.stringify(draft);
+  const base = `/api/v1/analyses/${modelId}/hyprn_mvp`;
+  async function request(path, payload) {
+    const response = await fetch(base + path, {method: payload ? 'POST' : 'GET', headers: {'Content-Type':'application/json', 'X-CSRF-Token':document.querySelector('meta[name="csrf-token"]').content}, ...(payload ? {body: JSON.stringify(payload)} : {})});
+    const result = await response.json();
+    if (!response.ok) throw new Error(result.error || 'Changes could not be saved. Your edits are still here.');
+    return result;
+  }
+  async function load() {
+    setPending(true); setError('');
+    try { const value = await request(''); setSaved(value); setDraft(clone(value)); setStatus(''); }
+    catch (e) { setError(e.message); } finally {setPending(false);}
+  }
+  useEffect(() => {setSaved(null); setDraft(null); setSelected(null); load();}, [modelId]);
+  useEffect(() => {if (draft?.components.some(c => c.id === selectedId)) setSelected(selectedId);}, [selectedId]);
+  useEffect(() => {
