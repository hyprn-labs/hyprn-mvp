+      {!draft.components.length && <div><p>No components yet. Add a component and declare its inputs and outputs.</p><button className="btn btn-secondary" onClick={example}>Load two-component example</button></div>}
+      <label className="form-label">Component name<input className="form-control" value={newName} onChange={e=>setNewName(e.target.value)}/></label>{' '}<button className="btn btn-secondary" onClick={addComponent} disabled={!newName.trim()}>Add component</button>
+      {!selectedComponent ? <p>Select a component to inspect its code, inputs, outputs and assumptions.</p> : <div>
+        <h3>{selectedComponent.name}</h3>
+        <label className="form-label">Rename component<input className="form-control" value={selectedComponent.name} onChange={e=>componentEdit('name',e.target.value)}/></label>
