+class HyprnMvpController < ApplicationController
+  before_action :workspace, except: [:models]
+  rescue_from HyprnMvpWorkspace::Conflict, with: :conflict
+  rescue_from HyprnMvpWorkspace::Invalid, ActiveRecord::RecordInvalid, ActionController::ParameterMissing, KeyError, ArgumentError, with: :invalid
+  rescue_from ActiveRecord::RecordNotFound, with: -> { head :not_found }
+  rescue_from ActiveRecord::StatementInvalid, with: -> { render json: {error: "Concurrent edit could not be saved. Your edits are still here; retry."}, status: :conflict }
+
+  def models
+    render json: Analysis.owned_by(current_user).roots.order(:name).map { |m| {id: m.id, name: m.name} }
+  end
+
+  def show
+    render json: @workspace.read
+  end
+
+  def save
+    render json: @workspace.save(params.require(:command_id), params.require(:expected_revision), params.require(:payload).to_unsafe_h)
+  end
+
+  def validate
+    render json: @workspace.validate(params.require(:expected_revision))
+  end
+
+  private
+  def workspace
+    @model = Analysis.find(params[:analysis_id])
+    unless current_user.has_role?(:owner, @model)
+      return render json: {error: "Only the study owner can access this workspace"}, status: :forbidden
+    end
+    return render json: {error: "This model is locked"}, status: :forbidden if @model.locked && request.post?
+    return render json: {error: "Request exceeds 262144 bytes"}, status: :payload_too_large if request.content_length.to_i > HyprnMvpWorkspace::MAX_REQUEST
+    @workspace = HyprnMvpWorkspace.new(@model, current_user)
+  end
+  def conflict(error)
+    render json: {error: error.message}, status: :conflict
+  end
+  def invalid(error)
+    render json: {error: error.message}, status: :unprocessable_entity
+  end
+end
