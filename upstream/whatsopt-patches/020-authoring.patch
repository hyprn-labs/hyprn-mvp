+require "digest"
+require "open3"
+require "timeout"
+
+# All editable composition remains in native Analysis/Discipline/Variable/Connection.
+# The adopted receipt column holds scoped receipts, text metadata and immutable pins.
+class HyprnMvpWorkspace
+  class Conflict < StandardError; end
+  class Invalid < StandardError; end
+  MAX_REQUEST = 262144
+  attr_reader :model, :owner
+
+  def self.create(owner, name, command_id)
+    raise Invalid, "Invalid create command" unless command_id.to_s.match?(/\A[a-zA-Z0-9_-]{16,80}\z/)
+    raise Invalid, "Name exceeds request bounds" if name.to_s.bytesize > MAX_REQUEST
+    key = "create:#{owner.id}:#{command_id}"
+    digest = Digest::SHA256.hexdigest(JSON.generate(name))
+    owner.with_lock do
+      Analysis.owned_by(owner).each do |model|
+        receipt = JSON.parse(model.probe_receipts)[key]
+        next unless receipt
+        raise Conflict, "Command payload conflict" unless receipt["digest"] == digest
+        return model
+      end
+      model = Analysis.create!(name: name, public: false)
+      model.set_owner(owner)
+      model.update_columns(probe_receipts: JSON.generate({key => {"digest" => digest}}))
+      model
+    end
+  end
+
+  def initialize(model, owner)
+    @model, @owner = model, owner
+  end
+
+  def store
+    @store ||= JSON.parse(model.probe_receipts)
+  end
+
+  def records
+    store["_workspace"] ||= {"metadata" => {}, "receipts" => {}, "roots" => {}, "configurations" => {}}
+  end
+
+  def persist
+    model.update_columns(probe_receipts: JSON.generate(store))
+  end
+
+  def snapshot
+    metadata = records.fetch("metadata")
+    components = model.disciplines.nodes.order(:id).map do |d|
+      {"id" => d.id, "name" => d.name, "source" => d.openmdao_impl&.python_source.to_s,
+       "notes" => metadata.fetch("notes", {}).fetch(d.id.to_s, ""),
+       "ports" => d.variables.order(:id).map { |v| v.attributes.slice("id", "name", "io_mode", "type", "shape", "units", "desc") }}
+    end
+    connections = Connection.of_analysis(model.id).order(:id).map { |c| c.attributes.slice("id", "from_id", "to_id", "role") }
+    free = model.driver.variables.outs.order(:id).select { |v| v.outgoing_connections.exists? }.map { |v| v.attributes.slice("id", "name", "type", "shape", "units") }
+    state = {"id" => model.id, "name" => model.name, "description" => metadata.fetch("description", ""),
+      "boundary" => metadata.fetch("boundary", ""), "criteria" => metadata.fetch("criteria", []),
+      "components" => components, "connections" => connections, "free_inputs" => free,
+      "native_updated_at" => model.updated_at.iso8601(6)}
+    state["revision"] = Digest::SHA256.hexdigest(JSON.generate(state))
+    state
+  end
+
+  def read
+    model.with_lock { @store = nil; snapshot }
+  end
+
+  def command(operation, id, revision, payload)
+    raise Invalid, "command_id: use a unique command identity" unless id.to_s.match?(/\A[a-zA-Z0-9_-]{16,80}\z/)
+    encoded = JSON.generate([revision, payload])
+    raise Invalid, "request: exceeds #{MAX_REQUEST} bytes" if encoded.bytesize > MAX_REQUEST
+    digest = Digest::SHA256.hexdigest(encoded)
+    key = "#{owner.id}:#{operation}:#{id}"
+    model.with_lock do
+      @store = nil
+      old = records["receipts"][key]
+      if old
+        raise Conflict, "Command payload conflict" unless old["digest"] == digest
+        return old["result"]
+      end
+      raise Conflict, "This model changed since you opened it. Your edits are still here; reload the saved version." unless snapshot["revision"] == revision
+      result = yield
+      records["receipts"][key] = {"digest" => digest, "result" => result}
+      persist
+      result
+    end
+  end
+
+  def validate_source(state)
+    request = {"operation" => "source", "components" => state.fetch("components")}
+    raise Invalid, "Add a component before validating the model" if request["components"].empty?
+    trusted(request)
+  end
+
+  def trusted(request)
+    input = JSON.generate(request)
+    raise Invalid, "request: exceeds #{MAX_REQUEST} bytes" if input.bytesize > MAX_REQUEST
+    # Fixed trusted executable/module; candidate text travels only on bounded stdin.
+    output, status = nil
+    Timeout.timeout(10) do
+      output, _error, status = Open3.capture3({"PYTHONDONTWRITEBYTECODE" => "1", "PYTHONPATH" => "/probe/integration/src"},
+        "/usr/local/bin/python", "-m", "hyprn_mvp_integration.native", stdin_data: input)
+    end
+    raise Invalid, "Validation response exceeded bounds" if output.bytesize > 65536
+    result = JSON.parse(output)
+    raise Invalid, result.fetch("error", "Validation unavailable") unless status.success?
+    result
+  rescue Timeout::Error, JSON::ParserError
+    raise Invalid, "Validation unavailable; your edits are still here"
+  end
+
+  def save(id, revision, payload)
+    command("save", id, revision, payload) do
+      metadata = records["metadata"]
+      %w[description boundary].each do |field|
+        if payload.key?(field)
+          raise Invalid, "#{field}: text required" unless payload[field].is_a?(String)
+          metadata[field] = payload[field]
+        end
+      end
+      model.name = payload["name"] if payload.key?("name")
+      model.save!
+      Array(payload["components"]).each do |attrs|
+        discipline = attrs["id"] ? model.disciplines.nodes.find(attrs["id"]) : model.disciplines.create!(name: attrs.fetch("name"))
+        discipline.update!(name: attrs["name"]) if attrs.key?("name")
+        if attrs.key?("source")
+          raise Invalid, "source: text required" unless attrs["source"].is_a?(String)
+          discipline.openmdao_impl.update!(python_source: attrs["source"])
+        end
+        if attrs.key?("notes")
+          raise Invalid, "notes: text required" unless attrs["notes"].is_a?(String)
+          (metadata["notes"] ||= {})[discipline.id.to_s] = attrs["notes"]
+        end
+        Array(attrs["ports"]).each do |port|
+          raise Invalid, "ports: real scalars only" unless port.fetch("shape", "1") == "1" && port.fetch("type", "Float") == "Float"
+          raise Invalid, "ports: direction must be in or out" unless %w[in out].include?(port["io_mode"])
+          variable = port["id"] ? discipline.variables.find(port["id"]) : discipline.variables.build
+          variable.update!(port.slice("name", "io_mode", "units", "desc").merge("type" => "Float", "shape" => "1"))
+        end
+      end
+      # Native refresh connects matching declared names and maintains native driver ports.
+      model.refresh_connections
+      Array(payload["remove_components"]).each do |id|
+        raise Invalid, "This component is referenced by a saved configuration and cannot be removed" if records["configurations"].values.any? { |c| c["root"]["components"].any? { |d| d["id"] == id } }
+        model.disciplines.nodes.find(id).destroy!
+      end
+      model.touch(time: [Time.current, model.updated_at + 0.000001].max)
+      model.reload
+      state = snapshot
+      validate_source(state) unless state["components"].empty?
+      records["roots"][state["revision"]] ||= state
+      state
+    end
+  end
+
+  def validate(revision)
+    model.with_lock do
+      @store = nil
+      state = snapshot
+      raise Conflict, "Model revision conflict" unless state["revision"] == revision
+      validate_source(state)
+    end
+  end
+end
