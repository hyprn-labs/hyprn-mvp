+    const navigate = e => {const link=e.target.closest('a[href]'); if(dirty && link && !link.getAttribute('href').startsWith('#')) {e.preventDefault(); e.stopPropagation(); setNavigation(link.href);}};
+    window.addEventListener('beforeunload',unload); document.addEventListener('click',navigate,true);
