+# SPDX-License-Identifier: AGPL-3.0-only
+require 'openssl'
+require 'base64'
+class ModelingContractController < ActionController::API
+  def dispatch_contract
+    @rid = SecureRandom.uuid
+    raw = request.body.read(2 * 1024 * 1024 + 1).to_s
+    raise ModelingContract::Failure.new(413, 'limit_exceeded') if raw.bytesize > 2 * 1024 * 1024
+    token = request.headers['Authorization'].to_s.delete_prefix('Bearer ')
+    header, payload, signature = token.split('.', -1)
+    raise ModelingContract::Failure.new(401, 'unauthenticated') unless signature && token.bytesize < 16384
+    key = File.binread(ENV.fetch('MODEL_KEY_FILE')).strip
+    expected = Base64.urlsafe_encode64(OpenSSL::HMAC.digest('SHA256', key, "#{header}.#{payload}"), padding: false)
+    raise ModelingContract::Failure.new(401, 'unauthenticated') unless ActiveSupport::SecurityUtils.secure_compare(expected, signature)
+    h = ModelingContract.parse(Base64.urlsafe_decode64(header))
+    scope = ModelingContract.parse(Base64.urlsafe_decode64(payload))
+    raise ModelingContract::Failure.new(401, 'unauthenticated') unless h == {'alg'=>'HS256','typ'=>'JWT'} && scope['expires_at'].is_a?(Integer) && scope['expires_at'] > Time.now.to_i && scope['expires_at'] <= Time.now.to_i + 300 && scope['method'] == request.method && scope['path'] == request.fullpath && scope['body_sha256'] == Digest::SHA256.hexdigest(raw)
+    %w[actor_id study_id request_id].each { |k| raise ModelingContract::Failure.new(401, 'unauthenticated') unless scope[k].to_s.match?(ModelingContract::UUID) }
+    raise ModelingContract::Failure.new(401, 'unauthenticated') unless scope['permissions'].is_a?(Array) && scope['resource_ids'].is_a?(Array)
+    @rid = scope['request_id']
+    body = raw.empty? ? {} : ModelingContract.parse(raw)
+    @command = body['command_id']
+    status, result = ModelingContract.new(scope).route(request.method, request.path.delete_prefix('/modeling/1'), request.query_parameters, body)
+    if result.key?('error')
+      result['error']['request_id'] = @rid
+    else
+      result = result.merge('schema_version'=>'1', 'request_id'=>@rid)
+    end
+    render json: result, status: status
+  rescue ModelingContract::Failure => e
+    render json: ModelingContract.error(e, @rid, @command), status: e.status
+  rescue JSON::ParserError, ArgumentError, TypeError
+    render json: ModelingContract.error(ModelingContract::Failure.new(400,'invalid_request'), @rid, @command), status: 400
+  rescue StandardError => e
+    # Diagnostics never include request payloads, tokens, source, or SQL.
+    Rails.logger.error("modeling contract failure: #{e.class.name} at #{e.backtrace.first}")
+    render json: ModelingContract.error(ModelingContract::Failure.new(503,'backend_unavailable', outcome: 'unknown'), @rid, @command), status: 503
+  end
+end
