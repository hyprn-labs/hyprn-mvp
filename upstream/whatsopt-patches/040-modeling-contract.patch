+# SPDX-License-Identifier: AGPL-3.0-only
+require 'json'
+require 'stringio'
+require 'securerandom'
+# Run before Rails logging/parameter extraction; never let ActionDispatch parse
+# unbounded candidate JSON. Controller repeats typed validation after auth.
+class ModelingRequestBounds
+  LIMIT = 2 * 1024 * 1024
+  def initialize(app) = @app=app
+  def call(env)
+    return @app.call(env) unless env['PATH_INFO'].start_with?('/modeling/1/')
+    raw=env['rack.input']&.read(LIMIT+1).to_s
+    status=raw.bytesize>LIMIT ? 413 : nil
+    begin
+      JSON.parse(raw,max_nesting:32,allow_nan:false,allow_duplicate_key:false) unless raw.empty? || status
+    rescue JSON::NestingError
+      status=413
+    rescue JSON::ParserError
+      status=400
+    end
+    if status
+      error={'error'=>{'code'=>status==413 ? 'limit_exceeded' : 'invalid_request','message'=>'Request boundary rejected JSON','request_id'=>SecureRandom.uuid,'command_id'=>nil,'resource_id'=>nil,'current_revision'=>nil,'fields'=>[],'outcome'=>'unchanged'}}
+      return [status,{'content-type'=>'application/json'},[JSON.generate(error)]]
+    end
+    env['rack.input']=StringIO.new(raw)
+    @app.call(env)
+  end
+end
