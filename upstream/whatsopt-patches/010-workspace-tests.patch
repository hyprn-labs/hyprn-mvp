+require "test_helper"
+
+# Native server-rendered shell contract; interactive browser proof uses installed Chrome.
+class HyprnMvpWorkspaceShellTest < ActionDispatch::IntegrationTest
+  test "native viewer owns the authoring panel and authenticated shell" do
+    sign_in users(:user1)
+    model = Analysis.create!(name: "Keyboard workspace", public: false)
+    model.set_owner(users(:user1))
+    get "/analyses/#{model.id}"
+    assert_response :success
+    assert_select "[data-hyprn-mvp-workspace]"
+  end
+end
