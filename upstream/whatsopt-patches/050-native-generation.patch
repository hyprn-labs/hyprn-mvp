+    end
+    expected=model['connections'].map { |c| [variables.fetch(c['source_ref'].values_at('instance_id','port_id')).id,variables.fetch(c['target_ref'].values_at('instance_id','port_id')).id] }.sort
+    raise 'Unexpected native endpoints' unless Connection.pluck(:from_id,:to_id).sort==expected
+    raise 'Unexpected native variables' unless Variable.count==variables.size
+    raise 'Unexpected native ordering' unless analysis.disciplines.nodes.map(&:name)==order.map { |i| component(i['instance_id']) }
+    generator=WhatsOpt::OpenmdaoGenerator.new(analysis,static_only:true,symbol_maps:maps)
+    native_paths=generator._generate_code(directory)
