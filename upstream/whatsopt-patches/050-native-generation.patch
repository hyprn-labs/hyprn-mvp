+    end
+    bindings.each { |k,v| v.sort_by! { |item| item.fetch('path') } if v.is_a?(Array) }
+    files['generated/bindings.json']=ModelingContract.canonical(bindings)
+    files['generated/source-map.json']=ModelingContract.canonical({'schema_version'=>'1','transform_version'=>'1','entries'=>entries})
+    {'files'=>files.transform_values { |raw| Base64.strict_encode64(raw) },'origin'=>origin[0].delete_prefix(Rails.root.to_s+'/'),'templates'=>generator.static_templates.sort}
+  end
+end
