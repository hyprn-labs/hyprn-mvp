+    identifiers+=model['instances'].flat_map { |i| i.values_at('instance_id','definition_version_id') }
+    identifiers+=model['definitions'].flat_map { |d| d.values_at('definition_id','definition_version_id')+d['ports'].map { |p| p['port_id'] } }
+    raise 'Invalid frozen identifier' unless identifiers.all? { |id| id.is_a?(String) && id.match?(ModelingContract::UUID) }
+    raise 'Generation file count exceeded' if model['instances'].empty? || 2*model['instances'].size+9>NativeProgram::MAX_FILES
+    raise 'Invalid model digest' unless model['digest']==ModelingContract.digest(model.except('digest'))
+    raise 'Invalid configuration digest' unless configuration['digest']==ModelingContract.digest(configuration.except('digest'))
+    raise 'Incompatible configuration' unless validator.compatible(model,configuration)['compatible']
+    # Create Analysis before variables; never save it again after explicit wiring.
+    analysis=Analysis.create!(name:'frozen_model',public:false)
+    analysis.impl.update!(package_name:'frozen_model',parallel_group:false,use_units:true)
+    analysis.impl.nonlinear_solver.update!(name:'NonlinearRunOnce',iprint:0)
+    analysis.impl.linear_solver.update!(name:'LinearRunOnce',iprint:0)
+    remaining=model['instances'].to_h { |i| [i.fetch('instance_id'),i] }
+    order=[]
+    until remaining.empty?
+      ready=remaining.keys.select { |id| model['connections'].none? { |c| c['target_ref']['instance_id']==id && remaining.key?(c['source_ref']['instance_id']) } }.sort
+      raise 'Non-DAG input' if ready.empty?
+      ready.each { |id| order << remaining.delete(id) }
+    end
+    variables={};maps={};entries=[]
+    bindings={'schema_version'=>'1','inputs'=>[],'outputs'=>[],'components'=>[]}
+    incoming=model['connections'].map { |c| c['target_ref'] }
+    order.each_with_index do |instance,index|
+      iid=instance.fetch('instance_id');label=component(iid)
+      definition=model['definitions'].find { |d| d['definition_version_id']==instance['definition_version_id'] }
+      source=model['source_files'].find { |s| s['sha256']==definition['source_refs'].fetch(0) }
+      raw=Base64.strict_decode64(source.fetch('bytes')).force_encoding('UTF-8')
+      disc=Discipline.create!(analysis:analysis,name:label,position:index+1)
+      disc.impl.update!(python_source:raw,implicit_component:false,jax_component:false,support_derivatives:false,egmdo_surrogate:false)
+      maps[label]={'inputs'=>{},'outputs'=>{}}
+      bindings['components'] << {'component_id'=>iid,'instance_id'=>iid,'path'=>label}
+      definition['ports'].sort_by { |p| p['port_id'] }.each do |port|
+        pid=port.fetch('port_id');local=variable(pid);direction=port.fetch('direction')
+        variables[[iid,pid]]=Variable.create!(discipline:disc,name:local,io_mode:direction=='input' ? 'in' : 'out',type:'Float',shape:'1',units:port.fetch('units'))
+        maps[label][direction+'s'][port.fetch('code_symbol')]=local
+        target={'instance_id'=>iid,'port_id'=>pid}
+        unless direction=='input' && incoming.include?(target)
+          bindings[direction+'s'] << {'target'=>target,'path'=>label+'.'+local,'units'=>port.fetch('units'),'component_id'=>iid}
+        end
+      end
+      transforms=['indent','source_symbol_view','availability_observer']
+      transforms.unshift('line_endings') if raw.include?("\r")
+      transforms.unshift('utf8_bom_decode') if raw.start_with?("\uFEFF")
+      entries << {'instance_id'=>iid,'definition_version_id'=>definition.fetch('definition_version_id'),'source_path'=>'sources/'+source['sha256']+'.py','source_sha256'=>source['sha256'],'generated_path'=>'generated/impl/'+disc.impl.py_filename,'transforms'=>transforms}
+    end
+    model['connections'].sort_by { |c| c['connection_id'] }.each do |conn|
+      key=lambda { |ref| [ref.fetch('instance_id'),ref.fetch('port_id')] }
