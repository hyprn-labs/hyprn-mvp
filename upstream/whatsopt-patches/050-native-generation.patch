+# SPDX-License-Identifier: AGPL-3.0-only
+"""Scalar symbol access. No candidate evaluation in the modeling service."""
+class SymbolView:
+    def __init__(self, vector, names, assigned=None):
+        self._vector, self._names, self._assigned = vector, names, assigned
+
+    def __getitem__(self, symbol):
+        # Return a scalar copy: in-place mutation cannot bypass assignment tracking.
+        return float(self._vector[self._names[symbol]][0])
+
+    def __setitem__(self, symbol, value):
+        if self._assigned is None:
+            raise TypeError('Inputs are read-only')
+        name = self._names[symbol]
+        self._vector[name] = value
+        self._assigned.add(name)
