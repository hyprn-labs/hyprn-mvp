+    origin=generator.method(:_generate_code).source_location
+    raise 'Native generator origin changed' unless origin[0]==Rails.root.join('app/lib/whats_opt/openmdao_generator.rb').to_s
+    files=native_paths.to_h { |p| ['generated/'+Pathname.new(p).relative_path_from(Pathname.new(directory)).to_s,File.binread(p)] }
+    files['generated/native_support.py']=File.binread(Rails.root.join('app/lib/whats_opt/native_support.py'))
+    files['generated/entry.py']="from impl.frozen_model import FrozenModel\n\ndef build_model():\n    return FrozenModel()\n"
