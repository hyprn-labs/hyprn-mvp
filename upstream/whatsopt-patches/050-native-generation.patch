+    slot=(0...4).lazy.map { |n| File.open(root+"/slot-#{n}",File::RDWR|File::CREAT|File::NOFOLLOW,0600) }.find do |file|
+      if file.flock(File::LOCK_EX|File::LOCK_NB)
+        true
+      else
+        file.close;false
+      end
+    end
+    raise 'Generation concurrency limit' unless slot
+    directory=Dir.mktmpdir('request-',root)
+    lease=File.open(directory+'/lease',File::RDWR|File::CREAT|File::EXCL,0600)
+    lease.flock(File::LOCK_EX)
+    File.binwrite(directory+'/input.json',input)
+    log=File.open(directory+'/helper.log','wb',0600)
+    # Clean environment: helper has no model auth key, provider/app/runtime identity.
+    env={'PATH'=>'/usr/local/bin:/usr/bin:/bin','HOME'=>directory,'RAILS_ENV'=>'test','BUNDLE_GEMFILE'=>'/native/Gemfile','BUNDLE_WITHOUT'=>'production:staging','BUNDLE_FROZEN'=>'true','GEM_HOME'=>ENV.fetch('GEM_HOME','/usr/local/bundle'),'GEM_PATH'=>Gem.path.join(File::PATH_SEPARATOR),'DISABLE_BOOTSNAP'=>'1','NATIVE_STATIC_GENERATION'=>'1','SECRET_KEY_BASE'=>'static-generation-no-session-'*4}
