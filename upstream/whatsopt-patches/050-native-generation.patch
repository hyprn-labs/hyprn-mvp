+# SPDX-License-Identifier: AGPL-3.0-only
+# Fixed trusted Ruby entry; never accepts code, a draft ID or executable options.
+require 'json'
+require 'fileutils'
+directory=ARGV.fetch(0)
+raise 'Invalid scratch directory' unless ARGV.size==1 && directory.match?(%r{\A/tmp/hyprn-mvp-native-[0-9]+/request-[a-zA-Z0-9-]+\z}) && File.directory?(directory) && !File.symlink?(directory) && File.stat(directory).uid==Process.uid && File.stat(directory).mode & 0777 == 0700
+Process.setrlimit(:CPU,20,20)
+Process.setrlimit(:AS,1024*1024*1024,1024*1024*1024)
+Process.setrlimit(:FSIZE,16*1024*1024,16*1024*1024)
+Process.setrlimit(:NOFILE,128,128)
+Process.setrlimit(:CORE,0,0)
+Thread.new { sleep 28; Process.kill('KILL',Process.pid) }
+File.umask(0077)
+ENV['DATABASE_URL']='sqlite3:'+directory+'/native.sqlite3'
+ENV['RAILS_ENV']='test'
+ENV['DISABLE_BOOTSNAP']='1'
+require '/native/config/environment'
+# This process owns its connection from boot; the server never rebinds one.
+raise 'Unexpected database' unless ActiveRecord::Base.connection_db_config.database==directory+'/native.sqlite3'
+ActiveRecord::Schema.verbose=false
+load '/native/db/schema.rb'
+ActiveRecord::Base.connection.add_column(:openmdao_discipline_impls,:python_source,:text) unless ActiveRecord::Base.connection.column_exists?(:openmdao_discipline_impls,:python_source)
+OpenmdaoDisciplineImpl.reset_column_information
+request=ModelingContract.parse(File.binread(directory+'/input.json',2*1024*1024+1))
+raise 'Unexpected request fields' unless request.keys.sort==%w[configuration model]
+FileUtils.mkdir(directory+'/generated',mode:0700)
+result=NativeMaterializer.render(request.fetch('model'),request.fetch('configuration'),directory+'/generated')
+File.binwrite(directory+'/output.json',JSON.generate(result))
